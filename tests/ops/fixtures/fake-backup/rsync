#!/usr/bin/env bash
# Fake rsync: records uploads, serves the box's nightly/ listing from $FAKE_HOST/box-nights, and answers
# a checksum dry run with $FAKE_HOST/verify-diff when that file exists. fail-upload, fail-pins, fail-mark
# and fail-list fail the matching call.
printf '%s\n' "$*" >> "$FAKE_HOST/rsync.log"
case "$*" in
  *--list-only*)
    [ -e "$FAKE_HOST/fail-list" ] && exit 23
    while read -r night; do printf 'drwx------ 4096 2026/11/01 02:22:01 %s\n' "$night"; done < "$FAKE_HOST/box-nights"
    ;;
  *-rnci*) cat "$FAKE_HOST/verify-diff" 2> /dev/null ;;
  *pinned.json*) [ -e "$FAKE_HOST/fail-pins" ] && exit 12 ;;
  *)
    [ -e "$FAKE_HOST/fail-upload" ] && exit 12
    for a in "$@"; do
      case "$a" in
        */out/OK)
          [ -e "$FAKE_HOST/fail-mark" ] && exit 12
          cp "$a" "$FAKE_HOST/uploaded/OK"
          ;;
        */out/) cp "$a"* "$FAKE_HOST/uploaded/" 2> /dev/null ;;
      esac
    done
    ;;
esac
exit 0
