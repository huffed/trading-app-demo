#!/usr/bin/env bash
# Fake curl for tests/ops/kill-switch-scripts.test.ts. Answers from files under $FAKE_HOST and
# records every call in $FAKE_HOST/curl.log. A file fail-<name> makes that call exit 22, as curl -f does.
for a in "$@"; do [ "$a" = "@-" ] && cat > /dev/null; done
url=""
method=GET
prev=""
for a in "$@"; do
  case "$a" in http*) url=$a ;; esac
  [ "$prev" = "-X" ] && method=$a
  prev=$a
done
printf '%s %s\n' "$method" "$url" >> "$FAKE_HOST/curl.log"
fail() { if [ -e "$FAKE_HOST/fail-$1" ]; then exit 22; fi; }
case "$url" in
  */login) printf '200' ;;
  *ntfy.sh/*) fail ntfy ;;
  */api/admin/flatten-algo*)
    fail flatten
    id=${url##*id=}
    cat "$FAKE_HOST/flatten-$id.json" 2> /dev/null || printf '{"flattened":0,"results":[]}'
    printf '\n200'
    ;;
  *"/rest/v1/algorithms?status=eq.active&select=id")
    fail list-active
    cat "$FAKE_HOST/active.json"
    ;;
  *"/rest/v1/algorithms?status=eq.active")
    fail pause
    printf '[]' > "$FAKE_HOST/active.json"
    ;;
  *"/rest/v1/algorithms?status=eq.paused"*)
    fail unpause
    cat "$FAKE_HOST/mirroring.json"
    ;;
  *"/rest/v1/algorithms?id=in."*"select=live_trading_enabled")
    fail mirroring
    cat "$FAKE_HOST/mirroring.json"
    ;;
  *"/rest/v1/paper_positions?"*)
    fail open-count
    cat "$FAKE_HOST/open.json"
    ;;
  *) echo "fake curl: unexpected url $url" >&2; exit 3 ;;
esac
