# /etc/systemd/system/quanttrader-failure.service — D.4 (decision 0009): fired by OnFailure= of
# quanttrader.service when the app unit enters the failed state (Restart=always means systemd
# only gives up after StartLimitBurst; this pushes the moment it does). Posts one urgent ntfy
# message with the unit's last journal lines; the topic is read from the app's env file as ops.
[Unit]
Description=QuantTrader: push an ntfy alert when quanttrader.service fails

[Service]
Type=oneshot
User=ops
Group=ops
ExecStart=/opt/quanttrader/scripts/ops/notify-failure.sh quanttrader
