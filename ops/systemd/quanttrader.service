# /etc/systemd/system/quanttrader.service — D.2 (decision 0007): runs as `ops` on the
# system-wide Node (/usr/local, pinned by .nvmrc and checked by the deploy), listens on
# loopback only; the dashboard is reached over Tailscale (tailscale serve → 127.0.0.1:3000)
# and the cron wrappers call loopback. Apply: install -m 644 → systemctl daemon-reload →
# the next `make deploy` restarts it (never restart by hand to "finish" a deploy).
[Unit]
Description=QuantTrader production server (loopback :3000; Tailscale serve and the cron wrappers are its only clients)
After=network-online.target
Wants=network-online.target

[Service]
User=ops
Group=ops
WorkingDirectory=/opt/quanttrader
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/pnpm exec next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/quanttrader /var/log/quanttrader

[Install]
WantedBy=multi-user.target
