# /etc/systemd/system/quanttrader.service — D.2 (decision 0007): runs as `ops` on the
# system-wide Node at /usr/local (pinned by .nvmrc, checked by the deploy) and listens on
# loopback only; the dashboard is reached over the tailnet through quanttrader-tailnet.socket
# (systemd-socket-proxyd → 127.0.0.1:3000) and the cron wrappers call loopback. ExecStart runs Next's own entry point with node,
# not through pnpm: pnpm reads ~/.config/pnpm at start, which ProtectHome= makes EACCES,
# and `pnpm exec` would run a dependency check on every restart. HOME points at an
# ops-owned directory outside the checkout so nothing Node writes can dirty the tree.
# SuccessExitStatus=143: Next exits 143 on SIGTERM; without it every deliberate stop (a deploy's
# restart, the kill switch) ends the unit in `failed` (seen 2026-11-01 15:18Z). ExecStopPost runs
# the notify hook after every stop; it pushes only when SERVICE_RESULT is not success, rate-limited,
# so a crash loop under Restart=always (which never reaches `failed`, so OnFailure= would never
# fire) still reaches the phone. The hook lives outside the checkout (D.4 runbook) so it exists
# whatever commit is deployed.
# Apply: install -m 644 → systemctl daemon-reload → the next `make deploy` restarts it
# (never restart by hand to "finish" a deploy). ProtectSystem=full makes /usr, /boot and
# /etc read-only; /tmp stays shared because the quarterly-cycle route writes
# /tmp/quanttrader-cycles for the operator to collect.
[Unit]
Description=QuantTrader production server (loopback :3000; the tailnet socket proxy and the cron wrappers are its only clients)
After=network-online.target
Wants=network-online.target

[Service]
User=ops
Group=ops
WorkingDirectory=/opt/quanttrader
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/quanttrader
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node /opt/quanttrader/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
SuccessExitStatus=143
ExecStopPost=/usr/local/lib/quanttrader/notify-failure.sh quanttrader
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
