# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic — the LLM-trader path (dormant: no active algorithm enables
# rules.llm_trader today). No spend cap exists on the live path; the
# LLM_MONTHLY_BUDGET_USD ledger lives only in the archived harness
# (docs/DEBT.md D-07).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq (free tier — Llama 3.3 70B; dormant SaaS chat + free harness plumbing tests)
GROQ_API_KEY=your-groq-api-key

# OANDA v20 (practice host — HEAD of the live price chain, unmetered, plus
# the retail positioning snapshots). Required for live trading.
OANDA_API_KEY=your-oanda-api-key
# Optional override; defaults to api-fxpractice.oanda.com
# OANDA_API_HOST=

# cTrader Open API (dormant-by-design MT5 alternative — only needed if the
# cTrader broker path is activated)
# CTRADER_CLIENT_ID=
# CTRADER_CLIENT_SECRET=

# Alpha Vantage (free tier — 25 requests/day)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Finnhub (free tier — 60 calls/minute)
FINNHUB_API_KEY=your-finnhub-api-key

# Twelve Data (free tier — 800 credits/day). Primary source of LIVE QUOTES
# for paper fills and SL/TP checks; fallback provider for bars.
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Service-role key for cron jobs (Supabase project settings → API → service_role).
# NEVER prefix with NEXT_PUBLIC_ — server-only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared secret for the /api/cron/* and /api/admin/* routes. Generate with
# `openssl rand -hex 32`. Held by the VPS .env.local (app + cron wrappers)
# and your local .env.local. Rotate: docs/runbooks/rotate-cron-secret.md.
CRON_SECRET=your-cron-secret

# Optional: dead-man's-switch ping URL (healthchecks.io check or UptimeRobot
# heartbeat monitor). heartbeat-cron.sh pings it only when the pipeline is
# fully healthy; the monitor alerts when pings stop. See scripts/README.md.
HEARTBEAT_PING_URL=

# Single-operator scope for scan/manage crons — the operator user_id.
# When set, scan/manage only run this user's algos (this is NOT a SaaS).
OPERATOR_USER_ID=

# Optional: ntfy.sh phone push (m1-band-check-cron.sh; the dead-man workflow
# reads the same names from GitHub Actions secrets).
# NTFY_TOPIC=
# NTFY_TOKEN=

# Optional: healthchecks ping for the monthly validate-algo cron wrapper.
# VALIDATE_MONTHLY_HEARTBEAT_URL=

# Research feature flags (read by src/lib/algo-search and the backtester;
# default off / default warn). Names documented for completeness — leave unset.
# ENABLE_FOREX_SEARCH=
# ENABLE_AXES_2026_10=
# PORTFOLIO_BACKTEST_FALLBACK_WARN=
# ROBUSTNESS_AUDIT_DIR=

# Research scripts under scripts/canonical read ~160 further knobs
# (MODE, ALGO, TARGETS, …); see scripts/README.md. None are secrets.
