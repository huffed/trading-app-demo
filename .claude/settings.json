{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make lint-shell)",
      "Bash(make lint-workflows)",
      "Bash(make lint-strict *)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make backtest)",
      "Bash(make check)",
      "Bash(make env-check)",
      "Bash(make fence-check)",
      "Bash(make db-types-check)",
      "Bash(make format-check *)",
      "Bash(make regime-report *)",
      "Bash(make help)",
      "Bash(pnpm test)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(make backtest-update *)",
      "Bash(make deploy *)",
      "Bash(make deploy)",
      "Bash(make status *)",
      "Bash(make status)",
      "Bash(make logs *)",
      "Bash(make logs)",
      "Bash(make format *)",
      "Bash(make format-all-check *)",
      "Bash(make db-types *)",
      "Bash(make install *)",
      "Bash(make python-env *)",
      "Bash(make python-lock *)",
      "Bash(pnpm exec tsx scripts/golden-replay.ts *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier --write *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Edit(/.claude/**)",
      "Edit(/.husky/**)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(!.env.example)",
      "Edit(.env*)",
      "Edit(!.env.example)",
      "Edit(/scripts/canonical/data/**)",
      "Edit(/tests/golden/*.json)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-paths.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/post-edit-lint.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-validate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
